{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "平台消费数据报送数据集",
  "description": "分类表、平台、报送批次（含口径快照与观测值）。迟报、撤回、接口改版、历史回补均以独立批次表达，旧批次只追加不改写。",
  "type": "object",
  "required": ["categories", "platforms", "batches"],
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "domain"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "enum": ["goods", "service"]},
          "synonyms": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform_id", "name"],
        "additionalProperties": false,
        "properties": {
          "platform_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "batch_id", "platform_id", "period", "kind",
          "due_at", "received_at"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "withdrawal"}}},
            "then": {
              "not": {"required": ["methodology"]},
              "properties": {
                "observations": {"maxItems": 0}
              }
            }
          },
          {
            "if": {"properties": {"kind": {"not": {"const": "withdrawal"}}}},
            "then": {"required": ["methodology"]}
          }
        ],
        "properties": {
          "batch_id": {"type": "string", "minLength": 1},
          "platform_id": {"type": "string", "minLength": 1},
          "period": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
          "kind": {
            "type": "string",
            "enum": ["scheduled", "late", "api_revision", "backfill", "withdrawal"]
          },
          "due_at": {"type": "string", "format": "date"},
          "received_at": {"type": "string", "format": "date"},
          "supersedes": {"type": ["string", "null"]},
          "note": {"type": "string"},
          "methodology": {
            "type": "object",
            "required": [
              "coverage_note", "dictionary_version", "dedup_method",
              "refund_handling", "price_basis", "promo_basis",
              "quality_statement", "expected_share", "category_map"
            ],
            "additionalProperties": false,
            "properties": {
              "coverage_note": {"type": "string"},
              "dictionary_version": {"type": "string"},
              "dedup_method": {"type": "string"},
              "refund_handling": {"type": "string"},
              "price_basis": {"type": "string"},
              "promo_basis": {"type": "string"},
              "quality_statement": {"type": "string"},
              "expected_share": {"type": "number", "minimum": 0, "maximum": 1},
              "category_map": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              }
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "obs_id", "platform_category", "category",
                "sales_index", "yoy_growth"
              ],
              "additionalProperties": false,
              "properties": {
                "obs_id": {"type": "string", "minLength": 1},
                "platform_category": {"type": "string", "minLength": 1},
                "category": {"type": "string", "minLength": 1},
                "sales_index": {"type": "number"},
                "yoy_growth": {"type": "number"},
                "promo_share": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    }
  }
}
