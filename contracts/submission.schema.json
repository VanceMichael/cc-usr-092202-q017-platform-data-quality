{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "平台数据报送批次台账",
  "description": "append-only 台账：迟报、撤回、接口改版、历史回补均以新批次登记，不覆盖历史批次",
  "type": "object",
  "required": ["ledger_version", "batches"],
  "properties": {
    "ledger_version": {"type": "integer", "minimum": 1},
    "currency_unit": {"type": "string"},
    "submission_deadline_rule": {"type": "string"},
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "batch_id", "platform_id", "report_period", "event_type",
          "submitted_at", "supersedes", "reason", "methodology",
          "observations", "quality_declaration"
        ],
        "properties": {
          "batch_id": {"type": "string", "minLength": 1},
          "platform_id": {"type": "string", "minLength": 1},
          "report_period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
          "event_type": {
            "type": "string",
            "enum": ["regular", "late", "withdrawal", "api_change", "backfill"]
          },
          "submitted_at": {"type": "string", "format": "date"},
          "supersedes": {"type": ["string", "null"]},
          "reason": {"type": "string", "minLength": 1},
          "methodology": {
            "type": "object",
            "required": [
              "sample_coverage", "category_dictionary", "category_mappings",
              "dedup_method", "refund_treatment", "price_caliber",
              "quality_statement"
            ],
            "properties": {
              "sample_coverage": {"type": "string", "minLength": 1},
              "category_dictionary": {"type": "string", "minLength": 1},
              "category_mappings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["platform_path", "standard_code"],
                  "properties": {
                    "platform_path": {"type": "string"},
                    "standard_code": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              },
              "mapping_basis": {"type": "string"},
              "dedup_method": {"type": "string", "minLength": 1},
              "refund_treatment": {"type": "string", "minLength": 1},
              "price_caliber": {"type": "string", "minLength": 1},
              "quality_statement": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "category_code", "platform_path", "sales",
                "orders", "refunds", "period_start", "period_end"
              ],
              "properties": {
                "category_code": {"type": "string"},
                "platform_path": {"type": "string"},
                "sales": {"type": "number", "minimum": 0},
                "orders": {"type": "integer", "minimum": 0},
                "refunds": {"type": "number", "minimum": 0},
                "period_start": {"type": "string", "format": "date"},
                "period_end": {"type": "string", "format": "date"}
              },
              "additionalProperties": false
            }
          },
          "quality_declaration": {
            "type": "object",
            "required": ["declared_by", "declared_at", "statement"],
            "properties": {
              "declared_by": {"type": "string"},
              "declared_at": {"type": "string", "format": "date"},
              "statement": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
